# Copy to .env and fill in. .env is gitignored.

# Required for discover
GOOGLE_PLACES_API_KEY=

# Optional — enables Meta Ad Library signal
META_AD_LIBRARY_ACCESS_TOKEN=

# Optional — used by /firm/{id} overview tab Street View embed
GOOGLE_MAPS_EMBED_API_KEY=

# Behavior knobs (sane defaults if blank)
PIFINDER_DB_PATH=data/firms.db
PIFINDER_CACHE_DIR=data/cache
PIFINDER_LOG_LEVEL=INFO
PIFINDER_HTTP_TIMEOUT_S=20
PIFINDER_USER_AGENT=pifinder/0.1 (+contact: you@example.com)
